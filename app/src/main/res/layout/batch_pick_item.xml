<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/batchLaylist"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/layout_border_radious_hash"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/batchLay_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/_2sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/batchNo_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@color/white"
                android:gravity="center"
                android:layout_weight="0.8"
                android:padding="@dimen/_5sdp"
                android:text="o"
                android:visibility="gone"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp" />
            <View
                android:layout_width="1dp"
                android:visibility="gone"
                android:layout_height="@dimen/_30sdp"
                android:background="@color/gray_lit" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/avaiableQty_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.8"
                android:background="@color/white"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:text="0"
                android:selectAllOnFocus="true"
                android:textColor="@color/black"
                android:textSize="12dp" />
            <View
                android:layout_width="1dp"
                android:layout_height="@dimen/_30sdp"
                android:background="@color/gray_lit" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/batchQty_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:selectAllOnFocus="true"
                android:inputType="numberDecimal"
                android:padding="5dp"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="12dp" />

            <ImageView
                android:id="@+id/removeBatch"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="wrap_content"
                android:layout_weight="0.1"
                android:padding="@dimen/_5sdp"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_remove_circle_outline"
                app:tint="@color/red1" />

        </LinearLayout>

    </LinearLayout>


</LinearLayout>