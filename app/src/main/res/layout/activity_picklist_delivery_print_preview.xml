<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<RelativeLayout
    android:background="@color/white"
    android:orientation="vertical"
    android:id="@+id/rootLayout"
    android:visibility="visible"
    android:tag="enf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tsc_printer.InvoicePrintPreviewActivity">

    <LinearLayout
        android:background="@color/white"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".tsc_printer.InvoicePrintPreviewActivity">

        <TextView
            android:layout_width="wrap_content"
            android:padding="5dp"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:text="INVOICE"
            android:layout_height="wrap_content"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"
            android:padding="10dp"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#042B97"
                android:id="@+id/company_name"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/address1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textStyle="bold"
                android:layout_below="@+id/company_name"
                android:padding="3dp"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/address2"
                android:padding="3dp"
                android:visibility="gone"
                android:textStyle="bold"
                android:layout_below="@+id/address1"
                android:textSize="12sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/address3"
                android:visibility="gone"
                android:padding="3dp"
                android:textStyle="bold"
                android:layout_below="@+id/address2"
                android:textSize="12sp"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/mobile_no"
                android:padding="3dp"
                android:visibility="gone"
                android:textSize="12sp"
                android:layout_below="@+id/address3"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/gst_no"
                android:padding="3dp"
                android:visibility="gone"
                android:textSize="12sp"
                android:layout_below="@+id/mobile_no"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:background="#757575"
            android:layout_height="0.5dip"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:padding="10dp"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="3dp"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="130dp"
                    android:textSize="12sp"
                    android:text="Delivery Pick No"
                    android:textStyle="bold"
                    android:textColor="@color/dark_orang"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:id="@+id/sr_no"
                    android:textColor="@color/black"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="3dp"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="130dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_orang"
                    android:text="Delivery Pick Date"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:id="@+id/sr_date"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="150dp"
                    android:textSize="12sp"
                    android:text="Customer Code"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:id="@+id/customer_code"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="3dp"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="130dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_orang"
                    android:text="Customer Name"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:text=":"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:id="@+id/customer_name_value"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/adressLayout"
                android:visibility="visible"
                android:padding="3dp"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="130dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="Customer Address"
                    android:textColor="@color/dark_orang"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:text=":"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/delivery_address"
                    android:layout_marginLeft="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/address1Layout"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="150dp"
                    android:textSize="12sp"
                    android:text="Address 1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/cus_address1"
                    android:layout_marginLeft="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/address2Layout"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="150dp"
                    android:textSize="12sp"
                    android:text="Address 2"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/cus_address2"
                    android:layout_marginLeft="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/address3Layout"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="150dp"
                    android:textSize="12sp"
                    android:text="Address 3"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/cus_address3"
                    android:layout_marginLeft="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/address4Layout"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="150dp"
                    android:textSize="12sp"
                    android:text="Address 4"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/cus_address4"
                    android:layout_marginLeft="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/deliveryAddr_print_lay"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="150dp"
                    android:textSize="12sp"
                    android:text="Delivery Addr "
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text=":"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/deliveryAddr_print_txt"
                    android:layout_marginLeft="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:background="@color/gray_lit"
            android:layout_height="1dip"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_margin="4dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_clr1"
                android:text="User : "
                android:textStyle="bold"
                android:textSize="12sp"
                />
            <TextView
                android:id="@+id/del_preview_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text=""
                android:textSize="12sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_clr1"
                android:text="Date &amp; Time : "
                android:textStyle="bold"
                android:textSize="12sp"
                />
            <TextView
                android:id="@+id/del_preview_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text=""
                android:textSize="12sp"
                />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:background="@color/lightble1"
            android:padding="7dp"
        android:layout_marginTop="5dp"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="35dp"
                android:text="SNo"
                android:textStyle="bold"
                android:textColor="#042B97"
                android:textSize="13sp"
                android:layout_marginLeft="3dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="0dp"
                android:text="Item Code/Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#042B97"
                android:layout_weight="2"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="0dp"
                android:text="Uom"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#042B97"
                android:textStyle="bold"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="0dp"
                android:text="Delivery Qty"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#042B97"
                android:textStyle="bold"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="match_parent"
                android:text="Price"
                android:layout_weight="1.1"
                android:textColor="#042B97"
                android:textStyle="bold"
                android:visibility="gone"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_height="wrap_content"/>


            <TextView
                android:layout_width="match_parent"
                android:text="Total"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#042B97"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_weight="1.1"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/invoiceList"
            android:layout_width="match_parent"
            tools:listitem="@layout/pick_delivery_print_preview_item"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:paddingBottom="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:layout_alignParentBottom="true"
        android:paddingBottom="15dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:background="#757575"
            android:visibility="gone"
            android:layout_height="0.5dip"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_height="wrap_content">

            <TextView
                android:layout_width="110dp"
                android:padding="5dp"
                android:textColor="#212121"
                android:textSize="12sp"
                android:text="Item Discount"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:padding="5dp"
                android:textStyle="bold"
                android:layout_marginLeft="20dp"
                android:textColor="#212121"
                android:layout_gravity="center"
                android:gravity="center"
                android:text=":"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:padding="5dp"
                android:id="@+id/item_disc"
                android:textColor="#212121"
                android:textSize="12sp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content"/>
            </LinearLayout>

            <Space
                android:layout_width="0dip"
                android:layout_weight="1"
                android:layout_height="0dip"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

    <RelativeLayout
        android:id="@+id/design_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#8000"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:elevation="4dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <include
            layout="@layout/pdf_view_layout"/>

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>